{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "baseUrl": "./src",
    "paths": {
      "@orders/*": ["orders/*"],
      "@inventory": ["inventory/index.ts"],
      "@payments/*": ["payments/*"],
      "@storage/*": ["storage/*"]
    }
  },
  "include": ["src/**/*.ts"]
}
